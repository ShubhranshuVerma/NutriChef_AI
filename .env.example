# Copy this file to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored. Never commit real keys.

# ---------- App ----------
APP_NAME=NutriChef AI
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---------- LLM (Google Gemini) ----------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_CACHE=true                   # reuse saved answers: same request -> same result
LLM_THINKING=low                 # minimal | low | medium | high; empty = model default

# ---------- LangSmith (tracing) ----------
# Get a key at https://smith.langchain.com -> Settings -> API Keys.
# Leave LANGSMITH_API_KEY empty and tracing stays off; nothing else changes.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nutrichef-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- Embeddings / RAG (HuggingFace, runs locally) ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=data/processed/chroma_db
RECIPENLG_CSV_PATH=data/raw/RecipeNLG/full_dataset.csv
RECIPENLG_SUBSET_SIZE=15000

# ---------- Database ----------
DATABASE_URL=sqlite:///data/processed/nutrichef.db

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=sqlite:///mlflow.db  # local file database (MLflow no longer supports ./mlruns)
MLFLOW_EXPERIMENT_NAME=nutrichef-ranker

# ---------- Security ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=60

# ---------- Services ----------
API_BASE_URL=http://localhost:8000
